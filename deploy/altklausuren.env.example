AUTH_ENABLED=true
SECRET_KEY=replace-with-a-long-random-secret
ALTKLAUSUREN_DATA_DIR=/var/lib/altklausuren
UPLOAD_LIMIT_MB=80
TRUST_PROXY_HEADERS=true
# Öffentliche Basis-URL für QR-Codes / Session-Links (muss in Prod gesetzt sein)
PUBLIC_BASE_URL=https://altklausuren.forum-wi.de

GOOGLE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_REDIRECT_URI=https://altklausuren.forum-wi.de/auth/callback
ALLOWED_GOOGLE_DOMAIN=forum-wi.de
DRIVE_ROOT_FOLDER_ID=0AOnFniEMTZ8bUk9PVA
ADMIN_EMAILS=lukas.heinz@forum-wi.de

SERVICE_ACCOUNT_FILE=/var/lib/altklausuren/credentials/service_account.json

# Backup: Google-Drive-Ordner-ID für tägliches Datenbank-Backup (optional, aber empfohlen)
# Ordner anlegen auf drive.google.com, dann die ID aus der URL kopieren
BACKUP_DRIVE_FOLDER_ID=
